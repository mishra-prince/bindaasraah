# Optional ORS API key. Set in the shell (not automatically loaded):
#   export ORS_API_KEY='your_secret_key'
# With no key, the local demo uses the public, rate-limited Valhalla routing server.
ORS_API_KEY=
PORT=8765

# Optional browser-visible MapTiler key for vector maps. Restrict to your domains.
# Without it the MapLibre map uses OpenStreetMap raster tiles.
MAPTILER_API_KEY=
